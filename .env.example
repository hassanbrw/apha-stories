# Ye file .env bana kar bharo (Mac: cp .env.example .env)
# .env kabhi kisi ko mat bhejo aur git par mat daalo.

# script + image prompts (DeepSeek)  →  https://openrouter.ai/keys
OPENROUTER_KEY=<yahan apni key>

# voiceover + har lafz ki timing  →  ai33.pro
AI33_KEY=<yahan apni key>

# stock clips ka Gemini check + thumbnail  →  https://yunwu.ai
YUNWU_KEY=<yahan apni key>

# ---------- RunPod remote voice+render (pod/ folder dekho) ----------
# R2 (Cloudflare) — shared storage, local <-> pod
R2_ACCOUNT_ID=<yahan apni value>
R2_ACCESS_KEY_ID=<yahan apni value>
R2_SECRET_ACCESS_KEY=<yahan apni value>
R2_BUCKET=<yahan apna bucket naam>
R2_ENDPOINT=<yahan apna endpoint URL, jaisa https://<account-id>.r2.cloudflarestorage.com>

# RunPod API key (optional, --provider=runpod ke liye)  →  https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=<yahan apni key>

# Vast.ai API key (default provider — sasta nikla)  →  https://cloud.vast.ai/account/
VAST_API_KEY=<yahan apni key>

# GitHub Actions se ban kar push hui image (.github/workflows/build-pod-image.yml)
# format: ghcr.io/<github-username>/story-alpha-pod:latest
POD_IMAGE_NAME=<yahan image naam>

# (optional) Whisper model size pod par (default: small)
WHISPER_MODEL=small

# (optional) voice cloning — R2 par kisi reference .wav ka path (jaise "refs/antoni.wav")
# khaali chhodo to Chatterbox ki default voice use hogi
VOICE_REF_AUDIO=
